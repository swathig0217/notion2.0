# Copy to supabase/functions/.env for `pnpm functions:serve`. Never commit real keys.
# Server-only. The app never sees these.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# 1 = deterministic mock model (local dev and e2e without an API key). Never in production.
AI_MOCK=1
# AI actions allowed per workspace per hour.
AI_HOURLY_LIMIT=30
