# Copy to supabase/functions/.env for `pnpm functions:serve`. Never commit real keys.
# Server-only. The app never sees these.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# 1 = deterministic mock model (local dev and e2e without an API key). Never in production.
AI_MOCK=1
# AI actions allowed per workspace per hour.
AI_HOURLY_LIMIT=30
# Inbound email (Postmark). Postmark webhook URL: https://postmark:<INBOUND_WEBHOOK_SECRET>@<project>.supabase.co/functions/v1/inbound-email
INBOUND_EMAIL_DOMAIN=in.notion2.test
# Local/test value only. Use a long random secret in production.
INBOUND_WEBHOOK_SECRET=local-inbound-secret
INBOUND_EMAILS_PER_HOUR=50
# Hourly notifications: pg_cron sends "Authorization: Bearer <CRON_SECRET>" (see the Phase 3 migration for the Vault secrets).
# Local/test value only. Use a long random secret in production.
CRON_SECRET=local-cron-secret
# Optional: override Expo's push endpoint (tests).
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# Billing: "stub" lets the paywall grant/cancel Pro without a payment provider (local, e2e,
# internal testing). Leave empty in production until RevenueCat/Stripe are wired (LAUNCH.md).
BILLING_MODE=stub
