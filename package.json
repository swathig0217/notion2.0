{
  "name": "notion2",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter mobile start",
    "dev:web": "pnpm --filter mobile web",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local 2>/dev/null > packages/shared/src/db.types.ts",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:db": "supabase test db",
    "test:e2e": "pnpm --filter mobile test:e2e",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "eval": "pnpm --filter @notion2/evals eval"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
