# Copy the sections below to where each runtime reads them. Never commit real values.

# ---------------------------------------------------------------------------
# App (client-safe) -> apps/mobile/.env
# Everything prefixed EXPO_PUBLIC_ is bundled into the app. Never put secrets here.
# Local values come from `pnpm db:start` (API URL and anon key).
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=
# Set to 1 once provider credentials exist (Apple Developer account / Google OAuth client).
EXPO_PUBLIC_AUTH_APPLE=0
EXPO_PUBLIC_AUTH_GOOGLE=0

# ---------------------------------------------------------------------------
# Server only -> supabase/functions/.env (local) or `supabase secrets set` (hosted)
# Used by Edge Functions from Phase 2. Never referenced from apps/.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------------------------------------------------------------------------
# Supabase Auth providers -> environment of `supabase start` (see supabase/config.toml)
# ---------------------------------------------------------------------------
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
