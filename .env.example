# Copy the sections below to where each runtime reads them. Never commit real values.

# ---------------------------------------------------------------------------
# App (client-safe) -> apps/mobile/.env
# Everything prefixed EXPO_PUBLIC_ is bundled into the app. Never put secrets here.
# Local values come from `pnpm db:start` (API URL and anon key).
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=
# Set to 1 once provider credentials exist (Apple Developer account / Google OAuth client).
EXPO_PUBLIC_AUTH_APPLE=0
EXPO_PUBLIC_AUTH_GOOGLE=0
# Domain that receives forwarded emails (same as INBOUND_EMAIL_DOMAIN on the server).
EXPO_PUBLIC_INBOUND_EMAIL_DOMAIN=
# Public web app origin for client links, e.g. https://app.example.com (falls back to the current origin on web).
EXPO_PUBLIC_APP_URL=
# Local dev/e2e only: accept http:// webhook URLs in the app.
EXPO_PUBLIC_WEBHOOKS_ALLOW_INSECURE=0

# ---------------------------------------------------------------------------
# Server only -> supabase/functions/.env (local) or `supabase secrets set` (hosted)
# Used by Edge Functions from Phase 2. Never referenced from apps/.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Deterministic mock model for local dev/e2e (never in production). See supabase/functions/.env.example.
AI_MOCK=0
# AI actions allowed per workspace per hour.
AI_HOURLY_LIMIT=30
# Inbound email (Postmark) and notifications: see supabase/functions/.env.example.
INBOUND_EMAIL_DOMAIN=
INBOUND_WEBHOOK_SECRET=
CRON_SECRET=
# Billing: "stub" grants Pro without a provider (local/e2e only). Empty in production until RevenueCat/Stripe are wired (LAUNCH.md).
BILLING_MODE=
# Webhooks: 1 allows http:// and local endpoints (local dev/e2e only). Never in production.
WEBHOOKS_ALLOW_INSECURE=0

# ---------------------------------------------------------------------------
# Supabase Auth providers -> environment of `supabase start` (see supabase/config.toml)
# ---------------------------------------------------------------------------
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
